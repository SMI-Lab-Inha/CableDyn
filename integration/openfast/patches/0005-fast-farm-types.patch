+   call SetErrStat(ErrStat2, ErrMsg2, ErrStat, ErrMsg, RoutineName)
+   if (ErrStat >= AbortErrLev) return
+   call CD_CopyParam(SrcCDFarm_DataData%p, DstCDFarm_DataData%p, CtrlCode, ErrStat2, ErrMsg2)
+   call SetErrStat(ErrStat2, ErrMsg2, ErrStat, ErrMsg, RoutineName)
+   if (ErrStat >= AbortErrLev) return
+   call CD_CopyInput(SrcCDFarm_DataData%u, DstCDFarm_DataData%u, CtrlCode, ErrStat2, ErrMsg2)
