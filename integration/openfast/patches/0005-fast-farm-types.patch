+   if (allocated(SrcCDFarm_DataData%Input)) then
+      LB(1:1) = lbound(SrcCDFarm_DataData%Input)
+      UB(1:1) = ubound(SrcCDFarm_DataData%Input)
+      if (.not. allocated(DstCDFarm_DataData%Input)) then
+         allocate(DstCDFarm_DataData%Input(LB(1):UB(1)), stat=ErrStat2)
+         if (ErrStat2 /= 0) then
