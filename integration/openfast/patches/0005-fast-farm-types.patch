+   character(*),    intent(  out) :: ErrMsg
+   integer(B4Ki)   :: i1
+   integer(B4Ki)   :: LB(1), UB(1)
+   integer(IntKi)                 :: ErrStat2
+   character(ErrMsgLen)           :: ErrMsg2
+   character(*), parameter        :: RoutineName = 'Farm_DestroyCDFarm_Data'
+   ErrStat = ErrID_None
+   ErrMsg  = ''
+   call CD_DestroyContState(CDFarm_DataData%x, ErrStat2, ErrMsg2)
+   call SetErrStat(ErrStat2, ErrMsg2, ErrStat, ErrMsg, RoutineName)
+   call CD_DestroyDiscState(CDFarm_DataData%xd, ErrStat2, ErrMsg2)
+   call SetErrStat(ErrStat2, ErrMsg2, ErrStat, ErrMsg, RoutineName)
+   call CD_DestroyConstrState(CDFarm_DataData%z, ErrStat2, ErrMsg2)
+   call SetErrStat(ErrStat2, ErrMsg2, ErrStat, ErrMsg, RoutineName)
+   call CD_DestroyOtherState(CDFarm_DataData%OtherSt, ErrStat2, ErrMsg2)
+   call SetErrStat(ErrStat2, ErrMsg2, ErrStat, ErrMsg, RoutineName)
+   call CD_DestroyParam(CDFarm_DataData%p, ErrStat2, ErrMsg2)
+   call SetErrStat(ErrStat2, ErrMsg2, ErrStat, ErrMsg, RoutineName)
+   call CD_DestroyInput(CDFarm_DataData%u, ErrStat2, ErrMsg2)
+   call SetErrStat(ErrStat2, ErrMsg2, ErrStat, ErrMsg, RoutineName)
+   if (allocated(CDFarm_DataData%Input)) then
+      LB(1:1) = lbound(CDFarm_DataData%Input)
+      UB(1:1) = ubound(CDFarm_DataData%Input)
+      do i1 = LB(1), UB(1)
+         call CD_DestroyInput(CDFarm_DataData%Input(i1), ErrStat2, ErrMsg2)
+         call SetErrStat(ErrStat2, ErrMsg2, ErrStat, ErrMsg, RoutineName)
+      end do
+      deallocate(CDFarm_DataData%Input)
+   end if
+   if (allocated(CDFarm_DataData%InputTimes)) then
+      deallocate(CDFarm_DataData%InputTimes)
+   end if
+   call CD_DestroyOutput(CDFarm_DataData%y, ErrStat2, ErrMsg2)
+   call SetErrStat(ErrStat2, ErrMsg2, ErrStat, ErrMsg, RoutineName)
+   call CD_DestroyMisc(CDFarm_DataData%m, ErrStat2, ErrMsg2)
+   call SetErrStat(ErrStat2, ErrMsg2, ErrStat, ErrMsg, RoutineName)
+end subroutine
