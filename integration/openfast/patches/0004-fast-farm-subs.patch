+!----------------------------------------------------------------------------------------------------------------------------------
+!> Initialize a farm-level instance of CableDyn (MooringMod = 5): the CompMooring=5
+!> module in FAST.Farm mode -- Turbine<J> deck vocabulary, shared moorings included.
+!> Mirrors Farm_InitMD structurally (same cadence checks, same per-turbine inputs).
+SUBROUTINE Farm_InitCD( farm, ErrStat, ErrMsg )
+
+   type(All_FastFarm_Data), TARGET, INTENT(INOUT) :: farm
+   INTEGER(IntKi),                  INTENT(  OUT) :: ErrStat
+   CHARACTER(*),                    INTENT(  OUT) :: ErrMsg
+
+   type(CD_InitInputType)                         :: CD_InitInp
+   type(CD_InitOutputType)                        :: CD_InitOut
+   INTEGER(IntKi)                                 :: nt
+   INTEGER(IntKi)                                 :: ErrStat2
+   CHARACTER(ErrMsgLen)                           :: ErrMsg2
+   CHARACTER(*),   PARAMETER                      :: RoutineName = 'Farm_InitCD'
+   TYPE(MeshType), POINTER                        :: SubstructureMotion
+
+   ErrStat = ErrID_None
+   ErrMsg = ""
+
+   CALL WrScr(" --------- in Farm_InitCD, to initialize farm-level CableDyn ------- ")
+
+   ! FAST-CableDyn subcycles per FAST.Farm step (identical cadence rules to MoorDyn)
+   IF ( EqualRealNos( farm%p%dt_mooring, farm%p%DT_low ) ) THEN
+      farm%p%n_mooring = 1
+   ELSE
+      IF ( farm%p%dt_mooring > farm%p%DT_low ) THEN
+         ErrStat = ErrID_Fatal
+         ErrMsg = "The farm mooring coupling time step ("//TRIM(Num2LStr(farm%p%dt_mooring))// &
+                    " s) cannot be larger than FAST.Farm time step ("//TRIM(Num2LStr(farm%p%DT_low))//" s)."
+         RETURN
+      ELSE
+         farm%p%n_mooring = NINT( farm%p%DT_low / farm%p%dt_mooring )
+         IF ( .NOT. EqualRealNos( farm%p%DT_low, farm%p%dt_mooring * farm%p%n_mooring )  ) THEN
+            ErrStat = ErrID_Fatal
+            ErrMsg  = "The mooring coupling time step, DT_mooring ("//TRIM(Num2LStr(farm%p%dt_mooring))// &
+                      " s) must be an integer divisor of the FAST.Farm time step ("//TRIM(Num2LStr(farm%p%DT_low))//" s)."
+            RETURN
+         END IF
+      END IF
+   END IF
+
+   CD_InitInp%FileName  = farm%p%MD_FileName                    ! the farm mooring deck (CableDyn vocabulary)
+   CD_InitInp%RootName  = trim(farm%p%OutFileRoot)//'.FarmCD'
+   CD_InitInp%FarmSize  = farm%p%NumTurbines
+   CD_InitInp%Tmax      = farm%p%TMax
+
+   ALLOCATE( CD_InitInp%PtfmInit(6,farm%p%NumTurbines), CD_InitInp%TurbineRefPos(3,farm%p%NumTurbines), STAT = ErrStat2 )
+   if (Failed0("CableDyn PtfmInit and TurbineRefPos initialization inputs in FAST.Farm.")) return;
+
+   DO nt = 1,farm%p%NumTurbines
+      CD_InitInp%PtfmInit(:,nt) = farm%FWrap(nt)%m%Turbine%p_FAST%PlatformPosInit
+      CD_InitInp%TurbineRefPos(:,nt) = farm%p%WT_Position(:,nt)
+   END DO
+
+   CD_InitInp%WaveField => farm%FWrap(1)%m%Turbine%SeaSt%p%WaveField
+   CD_InitInp%g         = farm%FWrap(1)%m%Turbine%p_FAST%Gravity
+   CD_InitInp%rhoW      = CD_InitInp%WaveField%WtrDens
+
+   ! A shared farm-level mooring system has one environmental contract. Reject
+   ! heterogeneous turbine environments instead of silently adopting turbine 1.
+   DO nt = 2,farm%p%NumTurbines
+      IF ( .NOT. EqualRealNos(CD_InitInp%g, farm%FWrap(nt)%m%Turbine%p_FAST%Gravity) .OR. &
+           .NOT. EqualRealNos(CD_InitInp%rhoW, farm%FWrap(nt)%m%Turbine%SeaSt%p%WaveField%WtrDens) .OR. &
+           .NOT. EqualRealNos(CD_InitInp%WaveField%WtrDpth, &
+                              farm%FWrap(nt)%m%Turbine%SeaSt%p%WaveField%WtrDpth) ) THEN
+         ErrStat = ErrID_Fatal
+         ErrMsg = 'FAST.Farm CableDyn requires all turbines to share gravity, water density, and water depth.'
+         RETURN
+      END IF
+   END DO
+
+   ! (farm-level mooring VTK visualization is not wired for CableDyn yet)
+
+   ALLOCATE( farm%CD%Input( 2 ), farm%CD%InputTimes( 2 ), STAT = ErrStat2 )
+   if (Failed0("CD%Input and CD%InputTimes.")) return;
+
+   ! the host owns the environment: the farm mooring water column is the SeaState one
+   ! (stock MoorDyn leaves its farm WtrDepth 0 and trusts the deck; CableDyn's coupled
+   ! contract overrides the deck from the host, so pass the real depth through)
+   CD_InitInp%WtrDepth  = CD_InitInp%WaveField%WtrDpth
+
+   CALL CD_Init( CD_InitInp, farm%CD%Input(1), farm%CD%p, farm%CD%x, farm%CD%xd, farm%CD%z, &
+                 farm%CD%OtherSt, farm%CD%y, farm%CD%m, farm%p%DT_mooring, CD_InitOut, ErrStat2, ErrMsg2 )
+   if (Failed()) return;
+
+   farm%CD%IsInitialized = .true.
+
+   CALL CD_CopyInput (farm%CD%Input(1),  farm%CD%Input(2),  MESH_NEWCOPY, Errstat2, ErrMsg2);  if (Failed()) return;
+   farm%CD%InputTimes(1) =  0.0_DbKi
+   farm%CD%InputTimes(2) = -0.1_DbKi
+
+   CALL CD_CopyInput (farm%CD%Input(1), farm%CD%u,  MESH_NEWCOPY, Errstat2, ErrMsg2);  if (Failed()) return;
+
+   ALLOCATE( farm%m%CD_2_FWrap(farm%p%NumTurbines), farm%m%FWrap_2_CD(farm%p%NumTurbines), STAT = ErrStat2 )
+   if (Failed0("CD_2_FWrap and FWrap_2_CD.")) return;
+
+   do nt = 1,farm%p%NumTurbines
+      ! loads (a turbine with no moored objects carries a committed 1-node zero-load
+      ! mesh, so the mapping is always well-formed)
+      CALL MeshMapCreate( farm%CD%y%CoupledLoads(nt), farm%FWrap(nt)%m%Turbine%m_Glue%Ext%SubstructureLoadsFF, farm%m%CD_2_FWrap(nt), ErrStat2, ErrMsg2 )
+      if (Failed()) return;
+
+      ! kinematics
+      IF (farm%FWrap(nt)%m%Turbine%p_FAST%CompSub == Module_SD) then
+         SubstructureMotion => farm%FWrap(nt)%m%Turbine%SD%y%y3Mesh
+      ELSE
+         SubstructureMotion => farm%FWrap(nt)%m%Turbine%ED%y(iED)%PlatformPtMesh
+      END IF
+
+      CALL MeshMapCreate( SubstructureMotion, farm%CD%Input(1)%CoupledKinematics(nt), farm%m%FWrap_2_CD(nt), ErrStat2, ErrMsg2 )
+      if (Failed()) return;
+   end do
+
+   call CD_DestroyInitInput (CD_InitInp , ErrStat2, ErrMsg2); call SetErrStat(ErrStat2, ErrMsg2, ErrStat, ErrMsg, RoutineName)
+   call CD_DestroyInitOutput(CD_InitOut, ErrStat2, ErrMsg2); call SetErrStat(ErrStat2, ErrMsg2, ErrStat, ErrMsg, RoutineName)
+
+CONTAINS
+   logical function Failed()
+      CALL SetErrStat( ErrStat2, ErrMsg2, ErrStat, ErrMsg, RoutineName )
+      Failed = ErrStat >= AbortErrLev
+   end function Failed
+   logical function Failed0(txt)
+      character(*), intent(in) :: txt
+      if (ErrStat2 /= 0) then
+         ErrStat2 = ErrID_Fatal
+         ErrMsg2  = "Could not allocate "//trim(txt)
+      end if
+      CALL SetErrStat( ErrStat2, ErrMsg2, ErrStat, ErrMsg, RoutineName )
+      Failed0 = ErrStat >= AbortErrLev
+   end function Failed0
+END SUBROUTINE Farm_InitCD
+
+!----------------------------------------------------------------------------------------------------------------------------------
+!> One farm-level CableDyn substep: extrapolate inputs, map substructure kinematics in,
+!> advance, and map the per-turbine mooring loads back. Mirrors Farm_MD_Increment.
+SUBROUTINE Farm_CD_Increment(t, n_FMD, farm, ErrStat, ErrMsg)
+
+   REAL(DbKi),                      INTENT(IN   ) :: t
+   INTEGER(IntKi),                  INTENT(IN   ) :: n_FMD
+   type(All_FastFarm_Data), TARGET, INTENT(INOUT) :: farm
+   INTEGER(IntKi),                  INTENT(  OUT) :: ErrStat
+   CHARACTER(*),                    INTENT(  OUT) :: ErrMsg
+
+   INTEGER(IntKi)                                 :: nt
+   REAL(DbKi)                                     :: t_next
+   INTEGER(IntKi)                                 :: ErrStat2
+   CHARACTER(ErrMsgLen)                           :: ErrMsg2
+   CHARACTER(*),   PARAMETER                      :: RoutineName = 'Farm_CD_Increment'
+   TYPE(MeshType), POINTER                        :: SubstructureMotion
+
+   ErrStat = ErrID_None
+   ErrMsg = ""
+
+   t_next = t + farm%p%DT_mooring
+
+   CALL CD_Input_ExtrapInterp(farm%CD%Input, farm%CD%InputTimes, farm%CD%u, t_next, ErrStat2, ErrMsg2)
+   if (Failed()) return;
+
+   CALL CD_CopyInput (farm%CD%Input(1),  farm%CD%Input(2),  MESH_UPDATECOPY, Errstat2, ErrMsg2)
+   if (Failed()) return;
+   farm%CD%InputTimes(2) = farm%CD%InputTimes(1)
+
+   CALL CD_CopyInput (farm%CD%u,  farm%CD%Input(1),  MESH_UPDATECOPY, Errstat2, ErrMsg2)
+   if (Failed()) return;
+   farm%CD%InputTimes(1) = t_next
+
+   do nt = 1,farm%p%NumTurbines
+      IF (farm%FWrap(nt)%m%Turbine%p_FAST%CompSub == Module_SD) then
+         SubstructureMotion => farm%FWrap(nt)%m%Turbine%SD%y%y3Mesh
+      ELSE
+         SubstructureMotion => farm%FWrap(nt)%m%Turbine%ED%y(iED)%PlatformPtMesh
+      END IF
+
+      CALL Transfer_Point_to_Point( SubstructureMotion, farm%CD%Input(1)%CoupledKinematics(nt), farm%m%FWrap_2_CD(nt), ErrStat2, ErrMsg2 )
+      if (Failed()) return;
+   end do
+
+   CALL CD_UpdateStates( t, n_FMD, farm%CD%Input, farm%CD%InputTimes, farm%CD%p, farm%CD%x,  &
+                         farm%CD%xd, farm%CD%z, farm%CD%OtherSt, farm%CD%m, ErrStat2, ErrMsg2 )
+   if (Failed()) return;
+
+   CALL CD_CalcOutput( t, farm%CD%Input(1), farm%CD%p, farm%CD%x, farm%CD%xd, farm%CD%z,  &
+                       farm%CD%OtherSt, farm%CD%y, farm%CD%m, ErrStat2, ErrMsg2 )
+   if (Failed()) return;
+
+   do nt = 1,farm%p%NumTurbines
+      IF (farm%FWrap(nt)%m%Turbine%p_FAST%CompSub == Module_SD) then
+         SubstructureMotion => farm%FWrap(nt)%m%Turbine%SD%y%y3Mesh
+      ELSE
+         SubstructureMotion => farm%FWrap(nt)%m%Turbine%ED%y(iED)%PlatformPtMesh
+      END IF
+
+      ! a moorless turbine's 1-node mesh carries zero loads; mapping it is harmless
+      CALL Transfer_Point_to_Point( farm%CD%y%CoupledLoads(nt), farm%FWrap(nt)%m%Turbine%m_Glue%Ext%SubstructureLoadsFF,  &
+                                    farm%m%CD_2_FWrap(nt), ErrStat2, ErrMsg2, farm%CD%Input(1)%CoupledKinematics(nt), SubstructureMotion )
+      if (Failed()) return;
+   end do
+
+CONTAINS
+   logical function Failed()
+      CALL SetErrStat( ErrStat2, ErrMsg2, ErrStat, ErrMsg, RoutineName )
+      Failed = ErrStat >= AbortErrLev
+   end function Failed
+END SUBROUTINE Farm_CD_Increment
+
