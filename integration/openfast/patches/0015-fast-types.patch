+subroutine FAST_CopyCableDyn_Data(SrcCableDyn_DataData, DstCableDyn_DataData, CtrlCode, ErrStat, ErrMsg)
+   type(CableDyn_Data), intent(inout) :: SrcCableDyn_DataData
+   type(CableDyn_Data), intent(inout) :: DstCableDyn_DataData
+   integer(IntKi),  intent(in   ) :: CtrlCode
+   integer(IntKi),  intent(  out) :: ErrStat
+   character(*),    intent(  out) :: ErrMsg
+   integer(B4Ki)   :: i1
+   integer(B4Ki)                  :: LB(1), UB(1)
+   integer(IntKi)                 :: ErrStat2
+   character(ErrMsgLen)           :: ErrMsg2
+   character(*), parameter        :: RoutineName = 'FAST_CopyCableDyn_Data'
+   ErrStat = ErrID_None
+   ErrMsg  = ''
+   if (allocated(SrcCableDyn_DataData%x)) then
+      LB(1:1) = lbound(SrcCableDyn_DataData%x)
+      UB(1:1) = ubound(SrcCableDyn_DataData%x)
+      if (.not. allocated(DstCableDyn_DataData%x)) then
+         allocate(DstCableDyn_DataData%x(LB(1):UB(1)), stat=ErrStat2)
+         if (ErrStat2 /= 0) then
+            call SetErrStat(ErrID_Fatal, 'Error allocating DstCableDyn_DataData%x.', ErrStat, ErrMsg, RoutineName)
+            return
+         end if
+      end if
+      do i1 = LB(1), UB(1)
+         call CD_CopyContState(SrcCableDyn_DataData%x(i1), DstCableDyn_DataData%x(i1), CtrlCode, ErrStat2, ErrMsg2)
+         call SetErrStat(ErrStat2, ErrMsg2, ErrStat, ErrMsg, RoutineName)
+         if (ErrStat >= AbortErrLev) return
+      end do
+   end if
+   if (allocated(SrcCableDyn_DataData%xd)) then
+      LB(1:1) = lbound(SrcCableDyn_DataData%xd)
+      UB(1:1) = ubound(SrcCableDyn_DataData%xd)
+      if (.not. allocated(DstCableDyn_DataData%xd)) then
+         allocate(DstCableDyn_DataData%xd(LB(1):UB(1)), stat=ErrStat2)
+         if (ErrStat2 /= 0) then
+            call SetErrStat(ErrID_Fatal, 'Error allocating DstCableDyn_DataData%xd.', ErrStat, ErrMsg, RoutineName)
+            return
+         end if
+      end if
+      do i1 = LB(1), UB(1)
+         call CD_CopyDiscState(SrcCableDyn_DataData%xd(i1), DstCableDyn_DataData%xd(i1), CtrlCode, ErrStat2, ErrMsg2)
+         call SetErrStat(ErrStat2, ErrMsg2, ErrStat, ErrMsg, RoutineName)
+         if (ErrStat >= AbortErrLev) return
+      end do
+   end if
+   if (allocated(SrcCableDyn_DataData%z)) then
+      LB(1:1) = lbound(SrcCableDyn_DataData%z)
+      UB(1:1) = ubound(SrcCableDyn_DataData%z)
+      if (.not. allocated(DstCableDyn_DataData%z)) then
+         allocate(DstCableDyn_DataData%z(LB(1):UB(1)), stat=ErrStat2)
+         if (ErrStat2 /= 0) then
+            call SetErrStat(ErrID_Fatal, 'Error allocating DstCableDyn_DataData%z.', ErrStat, ErrMsg, RoutineName)
+            return
+         end if
+      end if
+      do i1 = LB(1), UB(1)
+         call CD_CopyConstrState(SrcCableDyn_DataData%z(i1), DstCableDyn_DataData%z(i1), CtrlCode, ErrStat2, ErrMsg2)
+         call SetErrStat(ErrStat2, ErrMsg2, ErrStat, ErrMsg, RoutineName)
+         if (ErrStat >= AbortErrLev) return
+      end do
+   end if
+   if (allocated(SrcCableDyn_DataData%OtherSt)) then
+      LB(1:1) = lbound(SrcCableDyn_DataData%OtherSt)
+      UB(1:1) = ubound(SrcCableDyn_DataData%OtherSt)
+      if (.not. allocated(DstCableDyn_DataData%OtherSt)) then
+         allocate(DstCableDyn_DataData%OtherSt(LB(1):UB(1)), stat=ErrStat2)
+         if (ErrStat2 /= 0) then
+            call SetErrStat(ErrID_Fatal, 'Error allocating DstCableDyn_DataData%OtherSt.', ErrStat, ErrMsg, RoutineName)
+            return
+         end if
+      end if
+      do i1 = LB(1), UB(1)
+         call CD_CopyOtherState(SrcCableDyn_DataData%OtherSt(i1), DstCableDyn_DataData%OtherSt(i1), CtrlCode, ErrStat2, ErrMsg2)
+         call SetErrStat(ErrStat2, ErrMsg2, ErrStat, ErrMsg, RoutineName)
+         if (ErrStat >= AbortErrLev) return
+      end do
+   end if
+   call CD_CopyParam(SrcCableDyn_DataData%p, DstCableDyn_DataData%p, CtrlCode, ErrStat2, ErrMsg2)
+   call SetErrStat(ErrStat2, ErrMsg2, ErrStat, ErrMsg, RoutineName)
+   if (ErrStat >= AbortErrLev) return
+   call CD_CopyOutput(SrcCableDyn_DataData%y, DstCableDyn_DataData%y, CtrlCode, ErrStat2, ErrMsg2)
+   call SetErrStat(ErrStat2, ErrMsg2, ErrStat, ErrMsg, RoutineName)
+   if (ErrStat >= AbortErrLev) return
+   call CD_CopyMisc(SrcCableDyn_DataData%m, DstCableDyn_DataData%m, CtrlCode, ErrStat2, ErrMsg2)
+   call SetErrStat(ErrStat2, ErrMsg2, ErrStat, ErrMsg, RoutineName)
+   if (ErrStat >= AbortErrLev) return
+   if (allocated(SrcCableDyn_DataData%Input)) then
+      LB(1:1) = lbound(SrcCableDyn_DataData%Input)
+      UB(1:1) = ubound(SrcCableDyn_DataData%Input)
+      if (.not. allocated(DstCableDyn_DataData%Input)) then
+         allocate(DstCableDyn_DataData%Input(LB(1):UB(1)), stat=ErrStat2)
+         if (ErrStat2 /= 0) then
+            call SetErrStat(ErrID_Fatal, 'Error allocating DstCableDyn_DataData%Input.', ErrStat, ErrMsg, RoutineName)
+            return
+         end if
+      end if
+      do i1 = LB(1), UB(1)
+         call CD_CopyInput(SrcCableDyn_DataData%Input(i1), DstCableDyn_DataData%Input(i1), CtrlCode, ErrStat2, ErrMsg2)
+         call SetErrStat(ErrStat2, ErrMsg2, ErrStat, ErrMsg, RoutineName)
+         if (ErrStat >= AbortErrLev) return
+      end do
+   end if
+   if (allocated(SrcCableDyn_DataData%InputTimes)) then
+      LB(1:1) = lbound(SrcCableDyn_DataData%InputTimes)
+      UB(1:1) = ubound(SrcCableDyn_DataData%InputTimes)
+      if (.not. allocated(DstCableDyn_DataData%InputTimes)) then
+         allocate(DstCableDyn_DataData%InputTimes(LB(1):UB(1)), stat=ErrStat2)
+         if (ErrStat2 /= 0) then
+            call SetErrStat(ErrID_Fatal, 'Error allocating DstCableDyn_DataData%InputTimes.', ErrStat, ErrMsg, RoutineName)
+            return
+         end if
+      end if
+      DstCableDyn_DataData%InputTimes = SrcCableDyn_DataData%InputTimes
+   end if
+end subroutine
+
+subroutine FAST_DestroyCableDyn_Data(CableDyn_DataData, ErrStat, ErrMsg)
+   type(CableDyn_Data), intent(inout) :: CableDyn_DataData
+   integer(IntKi),  intent(  out) :: ErrStat
+   character(*),    intent(  out) :: ErrMsg
+   integer(B4Ki)   :: i1
+   integer(B4Ki)   :: LB(1), UB(1)
+   integer(IntKi)                 :: ErrStat2
+   character(ErrMsgLen)           :: ErrMsg2
+   character(*), parameter        :: RoutineName = 'FAST_DestroyCableDyn_Data'
+   ErrStat = ErrID_None
+   ErrMsg  = ''
+   if (allocated(CableDyn_DataData%x)) then
+      LB(1:1) = lbound(CableDyn_DataData%x)
+      UB(1:1) = ubound(CableDyn_DataData%x)
+      do i1 = LB(1), UB(1)
+         call CD_DestroyContState(CableDyn_DataData%x(i1), ErrStat2, ErrMsg2)
+         call SetErrStat(ErrStat2, ErrMsg2, ErrStat, ErrMsg, RoutineName)
+      end do
+      deallocate(CableDyn_DataData%x)
+   end if
+   if (allocated(CableDyn_DataData%xd)) then
+      LB(1:1) = lbound(CableDyn_DataData%xd)
+      UB(1:1) = ubound(CableDyn_DataData%xd)
+      do i1 = LB(1), UB(1)
+         call CD_DestroyDiscState(CableDyn_DataData%xd(i1), ErrStat2, ErrMsg2)
+         call SetErrStat(ErrStat2, ErrMsg2, ErrStat, ErrMsg, RoutineName)
+      end do
+      deallocate(CableDyn_DataData%xd)
+   end if
+   if (allocated(CableDyn_DataData%z)) then
+      LB(1:1) = lbound(CableDyn_DataData%z)
+      UB(1:1) = ubound(CableDyn_DataData%z)
+      do i1 = LB(1), UB(1)
+         call CD_DestroyConstrState(CableDyn_DataData%z(i1), ErrStat2, ErrMsg2)
+         call SetErrStat(ErrStat2, ErrMsg2, ErrStat, ErrMsg, RoutineName)
+      end do
+      deallocate(CableDyn_DataData%z)
+   end if
+   if (allocated(CableDyn_DataData%OtherSt)) then
+      LB(1:1) = lbound(CableDyn_DataData%OtherSt)
+      UB(1:1) = ubound(CableDyn_DataData%OtherSt)
+      do i1 = LB(1), UB(1)
+         call CD_DestroyOtherState(CableDyn_DataData%OtherSt(i1), ErrStat2, ErrMsg2)
+         call SetErrStat(ErrStat2, ErrMsg2, ErrStat, ErrMsg, RoutineName)
+      end do
+      deallocate(CableDyn_DataData%OtherSt)
+   end if
+   call CD_DestroyParam(CableDyn_DataData%p, ErrStat2, ErrMsg2)
+   call SetErrStat(ErrStat2, ErrMsg2, ErrStat, ErrMsg, RoutineName)
+   call CD_DestroyOutput(CableDyn_DataData%y, ErrStat2, ErrMsg2)
+   call SetErrStat(ErrStat2, ErrMsg2, ErrStat, ErrMsg, RoutineName)
+   call CD_DestroyMisc(CableDyn_DataData%m, ErrStat2, ErrMsg2)
+   call SetErrStat(ErrStat2, ErrMsg2, ErrStat, ErrMsg, RoutineName)
+   if (allocated(CableDyn_DataData%Input)) then
+      LB(1:1) = lbound(CableDyn_DataData%Input)
+      UB(1:1) = ubound(CableDyn_DataData%Input)
+      do i1 = LB(1), UB(1)
+         call CD_DestroyInput(CableDyn_DataData%Input(i1), ErrStat2, ErrMsg2)
+         call SetErrStat(ErrStat2, ErrMsg2, ErrStat, ErrMsg, RoutineName)
+      end do
+      deallocate(CableDyn_DataData%Input)
+   end if
+   if (allocated(CableDyn_DataData%InputTimes)) then
+      deallocate(CableDyn_DataData%InputTimes)
+   end if
+end subroutine
+
+subroutine FAST_PackCableDyn_Data(RF, Indata)
+   type(RegFile), intent(inout) :: RF
+   type(CableDyn_Data), intent(in) :: InData
+   character(*), parameter         :: RoutineName = 'FAST_PackCableDyn_Data'
+   integer(B4Ki)   :: i1
+   integer(B4Ki)   :: LB(1), UB(1)
+   if (RF%ErrStat >= AbortErrLev) return
+   call RegPack(RF, allocated(InData%x))
+   if (allocated(InData%x)) then
+      call RegPackBounds(RF, 1, lbound(InData%x), ubound(InData%x))
+      LB(1:1) = lbound(InData%x)
+      UB(1:1) = ubound(InData%x)
+      do i1 = LB(1), UB(1)
+         call CD_PackContState(RF, InData%x(i1)) 
+      end do
+   end if
+   call RegPack(RF, allocated(InData%xd))
+   if (allocated(InData%xd)) then
+      call RegPackBounds(RF, 1, lbound(InData%xd), ubound(InData%xd))
+      LB(1:1) = lbound(InData%xd)
+      UB(1:1) = ubound(InData%xd)
+      do i1 = LB(1), UB(1)
+         call CD_PackDiscState(RF, InData%xd(i1)) 
+      end do
+   end if
+   call RegPack(RF, allocated(InData%z))
+   if (allocated(InData%z)) then
+      call RegPackBounds(RF, 1, lbound(InData%z), ubound(InData%z))
+      LB(1:1) = lbound(InData%z)
+      UB(1:1) = ubound(InData%z)
+      do i1 = LB(1), UB(1)
+         call CD_PackConstrState(RF, InData%z(i1)) 
+      end do
+   end if
+   call RegPack(RF, allocated(InData%OtherSt))
+   if (allocated(InData%OtherSt)) then
+      call RegPackBounds(RF, 1, lbound(InData%OtherSt), ubound(InData%OtherSt))
+      LB(1:1) = lbound(InData%OtherSt)
+      UB(1:1) = ubound(InData%OtherSt)
+      do i1 = LB(1), UB(1)
+         call CD_PackOtherState(RF, InData%OtherSt(i1)) 
+      end do
+   end if
+   call CD_PackParam(RF, InData%p) 
+   call CD_PackOutput(RF, InData%y) 
+   call CD_PackMisc(RF, InData%m) 
+   call RegPack(RF, allocated(InData%Input))
+   if (allocated(InData%Input)) then
+      call RegPackBounds(RF, 1, lbound(InData%Input), ubound(InData%Input))
+      LB(1:1) = lbound(InData%Input)
+      UB(1:1) = ubound(InData%Input)
+      do i1 = LB(1), UB(1)
+         call CD_PackInput(RF, InData%Input(i1)) 
+      end do
+   end if
+   call RegPackAlloc(RF, InData%InputTimes)
+   if (RegCheckErr(RF, RoutineName)) return
+end subroutine
+
+subroutine FAST_UnPackCableDyn_Data(RF, OutData)
+   type(RegFile), intent(inout)    :: RF
+   type(CableDyn_Data), intent(inout) :: OutData
+   character(*), parameter            :: RoutineName = 'FAST_UnPackCableDyn_Data'
+   integer(B4Ki)   :: i1
+   integer(B4Ki)   :: LB(1), UB(1)
+   integer(IntKi)  :: stat
+   logical         :: IsAllocAssoc
+   if (RF%ErrStat /= ErrID_None) return
+   if (allocated(OutData%x)) deallocate(OutData%x)
+   call RegUnpack(RF, IsAllocAssoc); if (RegCheckErr(RF, RoutineName)) return
+   if (IsAllocAssoc) then
+      call RegUnpackBounds(RF, 1, LB, UB); if (RegCheckErr(RF, RoutineName)) return
+      allocate(OutData%x(LB(1):UB(1)),stat=stat)
+      if (stat /= 0) then 
+         call SetErrStat(ErrID_Fatal, 'Error allocating OutData%x.', RF%ErrStat, RF%ErrMsg, RoutineName)
+         return
+      end if
+      do i1 = LB(1), UB(1)
+         call CD_UnpackContState(RF, OutData%x(i1)) ! x 
+      end do
+   end if
+   if (allocated(OutData%xd)) deallocate(OutData%xd)
+   call RegUnpack(RF, IsAllocAssoc); if (RegCheckErr(RF, RoutineName)) return
+   if (IsAllocAssoc) then
+      call RegUnpackBounds(RF, 1, LB, UB); if (RegCheckErr(RF, RoutineName)) return
+      allocate(OutData%xd(LB(1):UB(1)),stat=stat)
+      if (stat /= 0) then 
+         call SetErrStat(ErrID_Fatal, 'Error allocating OutData%xd.', RF%ErrStat, RF%ErrMsg, RoutineName)
+         return
+      end if
+      do i1 = LB(1), UB(1)
+         call CD_UnpackDiscState(RF, OutData%xd(i1)) ! xd 
+      end do
+   end if
+   if (allocated(OutData%z)) deallocate(OutData%z)
+   call RegUnpack(RF, IsAllocAssoc); if (RegCheckErr(RF, RoutineName)) return
+   if (IsAllocAssoc) then
+      call RegUnpackBounds(RF, 1, LB, UB); if (RegCheckErr(RF, RoutineName)) return
+      allocate(OutData%z(LB(1):UB(1)),stat=stat)
+      if (stat /= 0) then 
+         call SetErrStat(ErrID_Fatal, 'Error allocating OutData%z.', RF%ErrStat, RF%ErrMsg, RoutineName)
+         return
+      end if
+      do i1 = LB(1), UB(1)
+         call CD_UnpackConstrState(RF, OutData%z(i1)) ! z 
+      end do
+   end if
+   if (allocated(OutData%OtherSt)) deallocate(OutData%OtherSt)
+   call RegUnpack(RF, IsAllocAssoc); if (RegCheckErr(RF, RoutineName)) return
+   if (IsAllocAssoc) then
+      call RegUnpackBounds(RF, 1, LB, UB); if (RegCheckErr(RF, RoutineName)) return
+      allocate(OutData%OtherSt(LB(1):UB(1)),stat=stat)
+      if (stat /= 0) then 
+         call SetErrStat(ErrID_Fatal, 'Error allocating OutData%OtherSt.', RF%ErrStat, RF%ErrMsg, RoutineName)
+         return
+      end if
+      do i1 = LB(1), UB(1)
+         call CD_UnpackOtherState(RF, OutData%OtherSt(i1)) ! OtherSt 
+      end do
+   end if
+   call CD_UnpackParam(RF, OutData%p) ! p 
+   call CD_UnpackOutput(RF, OutData%y) ! y 
+   call CD_UnpackMisc(RF, OutData%m) ! m 
+   if (allocated(OutData%Input)) deallocate(OutData%Input)
+   call RegUnpack(RF, IsAllocAssoc); if (RegCheckErr(RF, RoutineName)) return
+   if (IsAllocAssoc) then
+      call RegUnpackBounds(RF, 1, LB, UB); if (RegCheckErr(RF, RoutineName)) return
+      allocate(OutData%Input(LB(1):UB(1)),stat=stat)
+      if (stat /= 0) then 
+         call SetErrStat(ErrID_Fatal, 'Error allocating OutData%Input.', RF%ErrStat, RF%ErrMsg, RoutineName)
+         return
+      end if
+      do i1 = LB(1), UB(1)
+         call CD_UnpackInput(RF, OutData%Input(i1)) ! Input 
+      end do
+   end if
+   call RegUnpackAlloc(RF, OutData%InputTimes); if (RegCheckErr(RF, RoutineName)) return
+end subroutine
